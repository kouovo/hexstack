{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsup",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:studio": "dotenv -e ../../.env -- drizzle-kit studio --config drizzle.config.ts"
  },
  "dependencies": {
    "@app/api-contract": "workspace:*",
    "@app/common": "workspace:*",
    "@app/identity": "workspace:*",
    "@app/todo": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@hono/otel": "^1.3.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.38.0",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "hono": "^4.13.13",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "thread-stream": "^4.0.0"
  },
  "devDependencies": {
    "@app/typescript-config": "workspace:*",
    "@types/node": "^24.10.0",
    "drizzle-kit": "^0.31.10",
    "tsup": "8.5.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
