{
  "name": "cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "app": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "cli": "dotenv -e ../../.env -- tsx src/index.ts",
    "start": "dotenv -e ../../.env -- node dist/cli.js",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@app/application": "workspace:*",
    "@app/bootstrap": "workspace:*",
    "@app/core": "workspace:*",
    "@app/cqrs": "workspace:*",
    "@app/di": "workspace:*",
    "@app/domain": "workspace:*",
    "@app/persistence": "workspace:*",
    "@app/storage": "workspace:*",
    "clipanion": "4.0.0-rc.4",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "thread-stream": "^4.0.0"
  },
  "devDependencies": {
    "@app/typescript-config": "workspace:*",
    "@types/node": "^24.10.0",
    "tsup": "8.5.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
