        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$service\" && (span.http.response.status_code >= 500 || (status = error && kind != server) || duration > 500ms) }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "description": "5xx responses, failed DB/cache/messaging/job spans, or anything over 500 ms. Handled 4xx (401/404) are excluded even though @hono/otel marks them as errors."
