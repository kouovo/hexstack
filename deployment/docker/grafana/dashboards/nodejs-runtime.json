{
  "uid": "app-nodejs-runtime",
  "title": "Node.js runtime",
  "tags": ["app", "opentelemetry", "nodejs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "description": "Provisioned from deployment/docker/grafana/dashboards/nodejs-runtime.json. Metrics from @opentelemetry/instrumentation-runtime-node plus process CPU/RSS (apps/api/src/telemetry.ts).",
  "links": [
    {
      "title": "API overview",
      "type": "link",
      "url": "/d/app-api-overview/api-overview",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(nodejs_eventloop_utilization_ratio, service_name)",
          "refId": "service"
        },
        "definition": "label_values(nodejs_eventloop_utilization_ratio, service_name)",
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "api",
          "value": "api"
        }
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(nodejs_eventloop_utilization_ratio{service_name=\"$service\"}, service_instance_id)",
          "refId": "instance"
        },
        "definition": "label_values(nodejs_eventloop_utilization_ratio{service_name=\"$service\"}, service_instance_id)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Event loop",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Event loop delay",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (service_instance_id) (nodejs_eventloop_delay_p50_seconds{service_name=\"$service\", service_instance_id=~\"$instance\"})",
          "legendFormat": "p50 {{service_instance_id}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max by (service_instance_id) (nodejs_eventloop_delay_p99_seconds{service_name=\"$service\", service_instance_id=~\"$instance\"})",
          "legendFormat": "p99 {{service_instance_id}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "max by (service_instance_id) (nodejs_eventloop_delay_max_seconds{service_name=\"$service\", service_instance_id=~\"$instance\"})",
          "legendFormat": "max {{service_instance_id}}"
        }
      ],
      "description": "How late a 10 ms sampling timer fires (perf_hooks.monitorEventLoopDelay). An idle process sits at ~10 ms: that is the sampling resolution. Read the value above it as lag; sustained p99 well over ~100 ms means CPU-bound work is blocking requests."
    },
    {
      "type": "timeseries",
      "title": "Event loop utilization",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (service_instance_id) (nodejs_eventloop_utilization_ratio{service_name=\"$service\", service_instance_id=~\"$instance\"})",
          "legendFormat": "{{service_instance_id}}"
        }
      ],
      "description": "Share of time the loop was busy. Close to 100% means the process is saturated."
    },
    {
      "type": "row",
      "title": "Memory",
      "id": 4,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Resident memory (RSS)",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (service_instance_id) (process_memory_usage_bytes{service_name=\"$service\", service_instance_id=~\"$instance\"})",
          "legendFormat": "{{service_instance_id}}"
        }
      ],
      "description": "Total memory of the process, including buffers and native allocations outside the V8 heap."
    },
    {
      "type": "timeseries",
      "title": "V8 heap used vs. size",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (service_instance_id) (v8js_memory_heap_used_bytes{service_name=\"$service\", service_instance_id=~\"$instance\"})",
          "legendFormat": "used {{service_instance_id}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (service_instance_id) (v8js_memory_heap_space_size_bytes{service_name=\"$service\", service_instance_id=~\"$instance\"})",
          "legendFormat": "size {{service_instance_id}}"
        }
      ],
      "description": "Used heap climbing after every GC, without levelling off, points to a leak."
    },
    {
      "type": "timeseries",
      "title": "Heap used by space",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (v8js_heap_space_name) (v8js_memory_heap_used_bytes{service_name=\"$service\", service_instance_id=~\"$instance\"})",
          "legendFormat": "{{v8js_heap_space_name}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "CPU, GC and handles",
      "id": 8,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      }
    },
    {
      "type": "timeseries",
      "title": "CPU usage",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (service_instance_id, cpu_mode) (rate(process_cpu_time_seconds_total{service_name=\"$service\", service_instance_id=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{cpu_mode}} {{service_instance_id}}"
        }
      ],
      "description": "CPU seconds per second (1.0 = one full core). The JS thread alone cannot use more than one core."
    },
    {
      "type": "timeseries",
      "title": "Time spent in GC",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (service_instance_id, v8js_gc_type) (rate(v8js_gc_duration_seconds_sum{service_name=\"$service\", service_instance_id=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{v8js_gc_type}} {{service_instance_id}}"
        }
      ],
      "description": "Fraction of wall time paused for garbage collection, by GC type."
    },
    {
      "type": "timeseries",
      "title": "Active handles by type",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (v8js_resource_type) (v8js_resource_active{service_name=\"$service\", service_instance_id=~\"$instance\"})",
          "legendFormat": "{{v8js_resource_type}}"
        }
      ],
      "description": "Sockets, timers etc. keeping the event loop alive. A steadily growing count usually means a leak (unclosed sockets/timers)."
    }
  ]
}
