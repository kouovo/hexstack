# Local development values only. Never commit real credentials.
PORT=3001
LOG_LEVEL=info
# Match deployment/docker/compose.yaml host ports.
POSTGRES_URL=postgres://app:app@localhost:6889/app
REDIS_URL=redis://localhost:6888
# Exact browser origins trusted by CORS and CSRF checks (the Next.js app).
# In production, web + API must share a site (e.g. app.example.com / api.example.com) and use HTTPS.
CORS_ORIGINS=http://localhost:3000
# Local HTTP only (Safari needs this). MUST be true with HTTPS in production; code default is true.
SESSION_COOKIE_SECURE=false

# Read by the running web server and injected into the browser (not baked into the image).
NEXT_PUBLIC_RPC_URL=http://localhost:3001/rpc

# Redis cache (separate app:cache namespace; does NOT change auth rate limiting / queue behavior).
CACHE_ENABLED=true
CACHE_KEY_PREFIX=app:cache:

# Object storage: same local/minio drivers and port shape as Kouo.
# Local root is relative to the process cwd. Use an absolute path to share it between apps/processes.
STORAGE_DRIVER=local
STORAGE_BUCKET=app
STORAGE_LOCAL_ROOT=.app-storage
# For MinIO: pnpm infra:storage, then set STORAGE_DRIVER=minio.
# It waits for MinIO and creates a private bucket. Console: http://localhost:9001.
# These are local-only root credentials; provision least-privilege credentials separately in production.
STORAGE_MINIO_ENDPOINT=http://localhost:9000
STORAGE_MINIO_ACCESS_KEY=app-local
STORAGE_MINIO_SECRET_KEY=app-local-development-only
STORAGE_MINIO_REGION=us-east-1
STORAGE_MINIO_USE_SSL=false

# Outbox relay tunables (defaults shown).
# OUTBOX_RELAY_TICK_INTERVAL_MS=5000
# OUTBOX_CLEANUP_TICK_INTERVAL_MS=3600000
# Durable consumer execution (BullMQ domain-event queue).
# DOMAIN_EVENT_JOB_ATTEMPTS=10
# DOMAIN_EVENT_JOB_BACKOFF_MS=1000
# DB_STATEMENT_TIMEOUT_MS=0
